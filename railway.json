{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npx prisma generate"
  },
  "deploy": {
    "startCommand": "npm run server:prod",
    "healthcheckPath": "/health/live",
    "restartPolicyType": "ON_FAILURE"
  }
}
