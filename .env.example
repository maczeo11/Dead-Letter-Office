# ── DB (hexagonal: swap provider in prisma/schema.prisma + change URL) ──
# Postgres (Neon/Railway) — default
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/test_db
# MySQL alternative — uncomment provider="mysql" in prisma/schema.prisma, then:
# DATABASE_URL=mysql://root:root@localhost:3306/deadletter

JWT_SECRET=32b-random-must-be-32-bytes-long-change-me
WEBHOOK_SECRET=dev-webhook-secret-change-me
PORT=3001
# Local dev rewrites target (next.config.ts uses API_URL when NEXT_PUBLIC_API_BASE is not http)
API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_BASE=http://localhost:3001/api
